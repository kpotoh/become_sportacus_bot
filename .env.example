BOT_TOKEN=123456:ABC-DEF
# Default timezone used when user has not set one yet
DEFAULT_TZ=Europe/Moscow
# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./sportic.db
# How often to check workout windows (minutes)
REMINDER_CHECK_MINUTES=1
# Broadcast release notes on startup when VERSION changes (1/0)
UPDATE_NOTIFY=1
